{
  "imports": {
    "date-fns": "npm:date-fns@4.4.0",
  },
  "test": {
    "include": ["tests/"],
  },
  // tasks は廃止した (d5b3815 で test を package.json scripts (= `vp run`) に一本化し、
  // download-fonts / extract-tags / deploy-og も続けて package.json scripts へ移した)。
  // タスクの入口は `vp run <task>` で、ここには定義しない。
  "nodeModulesDir": "auto",
  "unstable": ["temporal"],
  "lock": false,
}
