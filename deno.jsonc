{
  // テストはVitest (package.json の test タスク = `vp test`) で実行するため、
  // ここにはテスト設定 (imports/test) を置かない。Deno は download-fonts /
  // extract-tags の2スクリプトのランタイムとしてのみ使う (package.json
  // scripts 経由で `deno run -A` が呼ばれる。依存はjsr:/deno.landの直URLで
  // 解決されnode_modulesを必要としない)。
  "nodeModulesDir": "auto",
  "lock": false,
}
